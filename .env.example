# Copia este archivo a ".env" y llena tus datos si quieres que el proyecto
# se conecte a Firestore automáticamente al arrancar, sin usar el modal ⚙️.
# Estos valores se obtienen en: Firebase Console → Configuración del proyecto → tus apps → SDK config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
